          "content": {
            "size": 6627,
            "mimeType": "text/html",
            "compression": 0,
            "text": "<h1>\r\n <i class=\"fa fa fa-pencil\" aria-hidden=\"true\"></i>\r\n Generazione\r\n</h1>\r\n<div data-ng-include data-src=\"'html/includes/wizard.html' + vm.CONSTANTS.URL_ARGS\"></div>\r\n<div class=\"row\">\r\n <h2 class=\"col-xs-7\">\r\n  <i class=\"fa fa-folder\" aria-hidden=\"true\"></i>\r\n  Conferma e stampa\r\n </h2>\r\n <a data-ng-if=\"( ['V'].indexOf( vm.operazione ) > -1 ) && vm.HELP.VENDITA_CONFERMA_E_STAMPA\" href=\"{{vm.HELP.VENDITA_CONFERMA_E_STAMPA}}\" target=\"_blank\" class=\"col-xs-5 text-right\">\r\n  <i class=\"fa fa-2x fa-info-circle\" aria-hidden=\"true\"></i>\r\n  Info&amp;assistenza\r\n </a>\r\n <a data-ng-if=\"( ['A'].indexOf( vm.operazione ) > -1 ) && vm.HELP.ANNULLO_CONFERMA_E_STAMPA\" href=\"{{vm.HELP.ANNULLO_CONFERMA_E_STAMPA}}\" target=\"_blank\" class=\"col-xs-5 text-right\">\r\n  <i class=\"fa fa-2x fa-info-circle\" aria-hidden=\"true\"></i>\r\n  Info&amp;assistenza\r\n </a>\r\n <a data-ng-if=\"( ['AX'].indexOf( vm.operazione ) > -1 ) && vm.HELP.ANNULLOX_CONFERMA_E_STAMPA\" href=\"{{vm.HELP.ANNULLOX_CONFERMA_E_STAMPA}}\" target=\"_blank\" class=\"col-xs-5 text-right\">\r\n  <i class=\"fa fa-2x fa-info-circle\" aria-hidden=\"true\"></i>\r\n  Info&amp;assistenza\r\n </a>\r\n <a data-ng-if=\"( ['R'].indexOf( vm.operazione ) > -1 ) && vm.HELP.RESO_CONFERMA_E_STAMPA\" href=\"{{vm.HELP.RESO_CONFERMA_E_STAMPA}}\" target=\"_blank\" class=\"col-xs-5 text-right\">\r\n  <i class=\"fa fa-2x fa-info-circle\" aria-hidden=\"true\"></i>\r\n  Info&amp;assistenza\r\n </a>\r\n <a data-ng-if=\"( ['RX'].indexOf( vm.operazione ) > -1 ) && vm.HELP.RESOX_CONFERMA_E_STAMPA\" href=\"{{vm.HELP.RESOX_CONFERMA_E_STAMPA}}\" target=\"_blank\" class=\"col-xs-5 text-right\">\r\n  <i class=\"fa fa-2x fa-info-circle\" aria-hidden=\"true\"></i>\r\n  Info&amp;assistenza\r\n </a>\r\n</div>\r\n<form name=\"vm.myform\" novalidate=\"novalidate\" autocomplete=\"off\" data-ng-model-options=\"{ allowInvalid: true }\">\r\n <div class=\"row\">\r\n  <p class=\"col-sm-3 col-lg-2\">\r\n   <span class=\"control-label\">Tipo operazione:</span><br>\r\n   <strong class=\"h4\">{{vm.operazione | decode:'Operazione'}}</strong>\r\n  </p>\r\n  <p data-ng-if=\"['A', 'R'].indexOf( vm.operazione ) > -1\" class=\"col-sm-4 col-lg-3\">\r\n   <span class=\"control-label\">Documento commerciale originario:</span><br>\r\n   <strong class=\"h4\">{{vm.documento.documentoCommerciale.resoAnnullo.progressivo}}</strong>\r\n  </p>\r\n  <p data-ng-if=\"['AX', 'RX'].indexOf( vm.operazione ) > -1\" class=\"col-sm-4 col-lg-3\">\r\n   <span class=\"control-label\">Riferimento operazione originaria:</span><br>\r\n   <strong class=\"h4\">{{vm.documento.documentoCommerciale.resoAnnullo.progressivo}}</strong>\r\n  </p>\r\n  <p class=\"col-sm-3 col-lg-2\" data-ng-if=\"undefined !== vm.invio.progressivo\">\r\n   <span class=\"control-label\">Numero progressivo:</span><br>\r\n   <strong class=\"h4\">{{vm.invio.progressivo}}</strong>\r\n  </p>\r\n  <p class=\"col-sm-2\">\r\n   <span class=\"control-label\">Data emissione:</span><br>\r\n   <strong class=\"h4\">{{vm.documento.documentoCommerciale.dataOra}}</strong>\r\n  </p>\r\n  <p class=\"col-sm-2\"  data-ng-if=\"vm.documento.documentoCommerciale.cfCessionarioCommittente\">\r\n   <span class=\"control-label\">Codice Lotteria del cliente:</span><br>\r\n   <strong class=\"h4\">{{vm.documento.documentoCommerciale.cfCessionarioCommittente}}</strong>\r\n  </p>\r\n </div>\r\n <br>\r\n <hr>\r\n <div data-ng-include data-src=\"'html/includes/formhidden.html' + vm.CONSTANTS.URL_ARGS\"></div>\r\n <div data-ng-include data-src=\"'html/includes/formerrors.html' + vm.CONSTANTS.URL_ARGS\"></div>\r\n <div data-ng-if=\"( ! vm.myform.$valid ) || ( vm.extraControlli()['messaggi'].length > 0 ) || ( false === vm.progressivoNonASistema )\" role=\"alert\" class=\"alert alert-info\">\r\n  <p>\r\n   <i aria-hidden=\"true\" class=\"fa fa-exclamation-triangle\"></i>\r\n   <strong>Attenzione:</strong> la conferma dei dati &egrave; possibile solo a valle della rimozione di tutte le segnalazioni sopra indicate nella compilazione del documento\r\n  </p>\r\n </div>\r\n <br>\r\n <div class=\"row\">\r\n  <p class=\"col-sm-2 col-lg-1\">\r\n   <button type=\"button\" data-ng-disabled=\"vm.loading || ( undefined !== vm.invio.progressivo ) || ( ! vm.myform.$valid ) || ( vm.extraControlli()['messaggi'].length > 0 ) || ( false === vm.progressivoNonASistema )\" data-toggle=\"modal\" data-target=\"#confermaModal\" class=\"btn btn-primary\">\r\n    Conferma\r\n   </button>\r\n  </p>\r\n  <p data-ng-if=\"undefined !== vm.invio.progressivo\" class=\"col-sm-10 col-lg-11\">\r\n   <button type=\"button\" data-ng-click=\"vm.stampa( vm.invio.idtrx )\" class=\"btn btn-primary\">\r\n    <i class=\"fa fa-download\" aria-hidden=\"true\"></i>\r\n    Scarica e stampa file\r\n   </button>\r\n   <button type=\"button\" class=\"btn btn-primary\" style=\"margin-top: 0px;\"\r\n    data-ng-if=\"['V'].indexOf( vm.operazione ) > -1\"\r\n    data-ng-click=\"vm.stampa( vm.invio.idtrx, true )\"\r\n   >\r\n    <i class=\"fa fa-download\" aria-hidden=\"true\"></i>\r\n    Scarica e stampa file per regalo\r\n   </button>\r\n  </p>\r\n </div>\r\n <div data-ng-if=\"( false === vm.invio.esito ) && vm.invio.errori.length\">\r\n  <br>\r\n  <div class=\"table-responsive\">\r\n   <table class=\"table table-bordered\">\r\n    <caption>Elenco degli errori rilevati</caption>\r\n    <thead>\r\n     <tr>\r\n      <th>codice</th>\r\n      <th>Descrizione</th>\r\n     </tr>\r\n    </thead>\r\n    <tbody>\r\n     <tr data-ng-repeat=\"errore in vm.invio.errori\">\r\n      <th>{{errore.codice}}</th>\r\n      <td>{{errore.descrizione}}</td>\r\n     </tr>\r\n    </tbody>\r\n   </table>\r\n  </div>\r\n </div>\r\n <div data-ng-if=\"undefined === vm.invio.progressivo\" class=\"row\">\r\n  <br><br>\r\n  <p class=\"col-sm-6\">\r\n   <button type=\"button\" data-ng-click=\"vm.go( 'generazione/wizard3' )\" class=\"btn btn-default\">\r\n    <i class=\"fa fa-arrow-left\" aria-hidden=\"true\"></i>\r\n    Torna a Verifica dati\r\n   </button>\r\n  </p>\r\n </div>\r\n <br>\r\n</form>\r\n<div data-ng-include data-src=\"'html/includes/spinner.html' + vm.CONSTANTS.URL_ARGS\"></div>\r\n<br><br>\r\n<div id=\"confermaModal\" role=\"dialog\" aria-labelledby=\"confermaModalTitle\" tabindex=\"-1\" class=\"modal fade\">\r\n <div role=\"document\" class=\"modal-dialog\">\r\n  <div class=\"modal-content\">\r\n   <div class=\"modal-header\">\r\n    <h1 id=\"confermaModalTitle\" class=\"modal-title\">Conferma documento di {{vm.operazione | decode:'Operazione'}}</h1>\r\n   </div>\r\n   <div class=\"modal-body\">\r\n    <p>Una volta confermato un documento non potr&agrave; essere aggiornato e/o cancellato</p>\r\n    <p>Premi <strong>Procedi</strong> per portare a termine la generazione del documento commerciale</p>\r\n   </div>\r\n   <div class=\"modal-footer\">\r\n    <button type=\"button\" class=\"btn btn-primary\" data-dismiss=\"modal\" data-ng-click=\"vm.inviaDocumento()\">Procedi</button>\r\n    <button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\">Annulla</button>\r\n   </div>\r\n  </div>\r\n </div>\r\n</div>\r\n"
          },
