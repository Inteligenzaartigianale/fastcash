            "mimeType": "application/json;charset=UTF-8",
            "text": "{\"datiTrasmissione\":{\"formato\":\"DCW10\"},\"cedentePrestatore\":{\"identificativiFiscali\":{\"codicePaese\":\"IT\",\"partitaIva\":\"02488900974\",\"codiceFiscale\":\"02488900974\"},\"altriDatiIdentificativi\":{\"denominazione\":\"TOUCH SYSTEMS S.R.L.S\",\"indirizzo\":\"VIA SIENA 5\",\"numeroCivico\":\"\",\"cap\":\"59100\",\"comune\":\"PRATO\",\"provincia\":\"PO\",\"nazione\":\"IT\",\"modificati\":false,\"defAliquotaIVA\":\"22\",\"nuovoUtente\":false},\"multiAttivita\":[],\"multiSede\":[]},\"documentoCommerciale\":{\"cfCessionarioCommittente\":\"\",\"flagDocCommPerRegalo\":false,\"progressivoCollegato\":\"\",\"dataOra\":\"23/07/2026\",\"multiAttivita\":{\"codiceAttivita\":\"\",\"descAttivita\":\"\"},\"importoTotaleIva\":\"0.01803279\",\"scontoTotale\":\"0.00000000\",\"scontoTotaleLordo\":\"0.00000000\",\"totaleImponibile\":\"0.08196721\",\"ammontareComplessivo\":\"0.10000000\",\"totaleNonRiscosso\":\"0.00000000\",\"elementiContabili\":[{\"idElementoContabile\":\"\",\"resiPregressi\":\"0.00\",\"reso\":\"0.00\",\"quantita\":\"1.00\",\"descrizioneProdotto\":\"servizio\",\"prezzoLordo\":\"0.10000000\",\"prezzoUnitario\":\"0.08196721\",\"scontoUnitario\":\"0.00000000\",\"scontoLordo\":\"0.00000000\",\"aliquotaIVA\":\"22\",\"importoIVA\":\"0.01803279\",\"imponibile\":\"0.08196721\",\"imponibileNetto\":\"0.08196721\",\"totale\":\"0.10000000\",\"omaggio\":\"N\"}],\"vendita\":[{\"tipo\":\"PC\",\"importo\":\"0.10\"},{\"tipo\":\"PE\",\"importo\":\"0.00\"},{\"tipo\":\"TR\",\"importo\":\"0.00\",\"numero\":\"0\"},{\"tipo\":\"NR_EF\",\"importo\":\"0.00\"},{\"tipo\":\"NR_PS\",\"importo\":\"0.00\"},{\"tipo\":\"NR_CS\",\"importo\":\"0.00\"}],\"scontoAbbuono\":\"0.00\",\"importoDetraibileDeducibile\":\"0.00000000\"},\"flagIdentificativiModificati\":false}"
